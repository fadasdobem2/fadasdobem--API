# =============================================================================
# Fadas do Bem — API · exemplo de variáveis de ambiente
# Copie para `.env` e preencha. NUNCA versione o `.env` real.
# Este ficheiro documenta as variáveis mais relevantes (não é exaustivo).
# =============================================================================

# ---------- Runtime ----------
NODE_ENV=development
PORT=3000
# Timeout do shutdown gracioso (ms). Entre 5000 e 120000.
GRACEFUL_SHUTDOWN_MS=28000

# ---------- Base de dados (PostgreSQL) ----------
# Opção A — URL única (nuvem). Tem precedência sobre as variáveis DB_* abaixo.
# DATABASE_URL=postgres://user:pass@host:5432/fadasdobem
# Opção B — variáveis separadas (local/dev).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fadasdobem
DB_USER=postgres
DB_PASSWORD=postgres
DB_LOGGING=false
# SSL (habitual em nuvem). rejectUnauthorized=false só se o provedor usar cert self-signed.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# ---------- Pool de conexões (CRÍTICO para escalar) ----------
# Sem isto o Sequelize usa max=5 por processo e satura sob carga.
# REGRA: DB_POOL_MAX × nº_de_instâncias  <  max_connections do Postgres (menos margem
# para migrações/admin). Ex.: Postgres com 200 conexões e 8 instâncias → DB_POOL_MAX ≈ 20.
DB_POOL_MAX=20
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000
DB_POOL_EVICT_MS=1000

# ---------- Redis (obrigatório para rodar >1 instância) ----------
# Ativa: rate-limit global, cache RBAC coerente (pub/sub), Socket.io multi-instância,
# lock distribuído de billing/jobs e mutex de pagamento. Sem Redis, tudo degrada para
# comportamento de INSTÂNCIA ÚNICA (ok em dev; NÃO usar em produção com scale-out).
# Opção A — URL única:
# REDIS_URL=redis://:password@host:6379
# Opção B — variáveis separadas:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ---------- Motor de cobrança (billing) ----------
# TTL do lock distribuído do tick de cobrança (ms). Deve cobrir a duração máxima de um
# tick. Recomendado ≥ 2× o intervalo do tick. Evita cobrança dupla em N instâncias.
BILLING_LOCK_TTL_MS=30000

# ---------- Segurança / Auth ----------
JWT_SECRET=troque-por-um-segredo-forte
# Segredo do CSRF (mínimo 32 chars).
CSRF_SECRET=troque-por-um-segredo-forte-32-chars-min
# Homologação: desliga os rate limiters de auth (evita 429 ao alternar contas).
AUTH_RATE_LIMIT_DISABLED=false

# ---------- CORS / Proxy ----------
# Lista separada por vírgula dos front-ends permitidos.
CORS_ORIGINS=http://localhost:3001
# Atrás de proxy/load balancer (Nginx, Easypanel): habilita trust proxy p/ IP real.
TRUST_PROXY=false
TRUST_PROXY_COUNT=1
# Origem CORS do Socket.io (fallback: CORS_ORIGIN). Use a origem do front.
# SOCKET_CORS_ORIGIN=http://localhost:3001

# ---------- Migrações / Sync (usar com cuidado) ----------
# Em dev, ignora falha de migração no arranque (não usar em produção).
SKIP_MIGRATIONS_ON_FAILURE=false
# sequelize.sync — opt-in; evite `alter`/`force` em produção.
SEQUELIZE_SYNC=false
SEQUELIZE_SYNC_ALTER=false
SEQUELIZE_SYNC_FORCE=false

# ---------- Integrações (preencher conforme uso) ----------
# ANTHROPIC_API_KEY=
# AGORA_APP_ID=
# SESSION_VIDEO_TELECOM_DRIVER=WIDE_VOICE_VIDEO
# SEED_HOMOLOG_EMAIL=homolog@fadasdobem.test
# SEED_HOMOLOG_SPECIALIST_EMAIL=tarologa.homolog@fadasdobem.test

# ---------- Webhooks financeiros (F-01 Chatwoot, F-03 Agora): rejeitam por padrão sem segredo ----------
# Chatwoot: segredo do webhook (Configurações > Integrações > Webhooks; assinatura X-Chatwoot-Signature, HMAC-SHA256).
CHATWOOT_WEBHOOK_SECRET=
# Alternativa (versão sem assinatura ou via proxy): segredo compartilhado enviado no header X-Chatwoot-Webhook-Token.
CHATWOOT_WEBHOOK_TOKEN=
# Janela anti-replay em segundos (padrão 300) e freio por IP por minuto (padrão 600).
CHATWOOT_WEBHOOK_TOLERANCE_S=300
CHATWOOT_WEBHOOK_RATE_LIMIT_PER_MIN=600
# Somente dev/teste: desliga a autenticação. Ignorado quando NODE_ENV=production. Nunca em produção.
CHATWOOT_WEBHOOK_AUTH_DISABLED=false
# /lancar_pagamento: ids de agente Chatwoot autorizados (vírgula). Vazio = ninguém pode lançar.
CHATWOOT_LANCAR_PAGAMENTO_AGENT_IDS=
# Teto por lançamento de valor livre (padrão 500) e teto diário por agente (padrão 2000), em R$.
CHATWOOT_LANCAR_PAGAMENTO_MAX_BRL=500
CHATWOOT_LANCAR_PAGAMENTO_DAILY_MAX_BRL=2000
# Agora NCS: segredo do console (assinatura Agora-Signature-V2, HMAC-SHA256 do corpo bruto).
AGORA_NCS_SECRET=
AGORA_NCS_TOLERANCE_S=300
# Somente dev/teste (ignorado em produção).
AGORA_NCS_VERIFY_DISABLED=false

# ---------- Sistema B: Gestão Fadas sobre o banco LEGADO (MySQL/MariaDB do ASP32) ----------
# O módulo `src/gestao-fadas` só é montado com GESTAO_FADAS_ENABLED=true.
# A conexão com o legado é SEPARADA do PostgreSQL e é SOMENTE LEITURA. Use um usuário com SELECT apenas.
# Credenciais ficam só em variáveis de ambiente; nunca no código nem em arquivo versionado.
GESTAO_FADAS_ENABLED=false
# Onde ficam os dados NOVOS do sistema B: postgres (o PostgreSQL desta API; padrão e decisão do produto) ou mysql
# (alternativa que mantém o desenho antigo, tabelas gf_* no banco do suspiro). Com postgres o MySQL legado NUNCA é escrito
# e a conta que assina a gravação é o usuário logado da A (sem GESTAO_FADAS_ESCRITA_CONTA_ID).
GF_NOVOS_DADOS=postgres
# Regras de dinheiro de pagamento refeitas no servidor (Maturacao/42). Ligado por padrão; só `false` explícito desliga.
# GF_FINANCEIRO_REGRAS=true
# Gravação (somente tabelas gf_*; o legado do ASP nunca é alterado). Desligada por padrão.
GESTAO_FADAS_ESCRITA_ENABLED=false
# Gate: responde o contrato HTTP da API B em /api/auth, /api/operations, /api/payouts, /api/ops (precisa GESTAO_FADAS_ENABLED).
GESTAO_FADAS_GATE_ENABLED=false
# Origem da API B para login/sessão (primeira versão do gate), sem barra final.
GATE_B_ORIGEM=
# Ambiente (test liga as gravações de repasse; production ou vazio desliga) e, só com GF_NOVOS_DADOS=mysql, a conta de serviço das gravações.
FADAS_ENVIRONMENT=
GESTAO_FADAS_ESCRITA_CONTA_ID=
LEGADO_DB_HOST=
LEGADO_DB_PORT=3306
LEGADO_DB_NAME=
LEGADO_DB_USER=
LEGADO_DB_PASSWORD=
# Pool pequeno para não competir com o ASP no servidor compartilhado (padrão 2).
LEGADO_DB_POOL_MAX=2
# Tempo máximo de uma consulta no legado, em segundos (padrão 10).
LEGADO_DB_STATEMENT_TIMEOUT_S=10
# Somente leitura na sessão do banco (padrão true; não desligue sem decisão registrada).
LEGADO_DB_READ_ONLY=true
LEGADO_DB_SSL=false
LEGADO_DB_LOGGING=false

# Página /dados-teste (mostra a senha das contas de teste). SÓ em ambiente local; nunca em produção.
DADOS_TESTE_ENABLED=false

# ---------- Umbler Talk (API v1) ----------
# Token da API (perfil da conta no Umbler Talk). Só no servidor; nunca no front nem em log.
UMBLER_API_TOKEN=
UMBLER_ORGANIZATION_ID=
UMBLER_BASE_URL=https://app-utalk.umbler.com/api
# Escrita (nota, mensagem) na Umbler: desligada por padrão. Só ligar com a equipe avisada, numa conversa de teste.
UMBLER_ESCRITA_ENABLED=false
# Webhook de entrada: cabeçalho X-Umbler-Webhook-Token com este valor. Vazio = a rota responde 503.
UMBLER_WEBHOOK_TOKEN=
# Somente dev/teste. Ignorado em produção.
UMBLER_WEBHOOK_AUTH_DISABLED=false
