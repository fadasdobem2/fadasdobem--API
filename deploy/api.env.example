# /etc/fadasdobem-api/api.env  (EXEMPLO: só nomes e comentários, SEM valores de segredo)
# Copie para /etc/fadasdobem-api/api.env (root:fadasdobem-api, modo 640). Nunca versione o arquivo real.
# Os campos <SEGREDO> são preenchidos pelo operador na VPS (JWT e CSRF: use deploy/gerar-segredos.sh).
# Formato: NOME=valor, sem aspas, sem espaços em volta do "=" (o systemd lê este arquivo).

# ============ Execução ============
NODE_ENV=production
PORT=4010
# Atrás do Nginx: confiar no X-Forwarded-* (1 salto).
TRUST_PROXY=true
TRUST_PROXY_COUNT=1
GRACEFUL_SHUTDOWN_MS=28000

# ============ PostgreSQL (banco NOVO da API A, tabelas gf_* e plataforma) ============
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=fadasdobem_api
DB_USER=fadasdobem_api
DB_PASSWORD=<SEGREDO>
DB_SSL=false
DB_LOGGING=false
DB_POOL_MAX=10

# ============ Redis (limite de tentativas, cache de permissões, Socket.IO) ============
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=<SEGREDO>      # use se o Redis tiver senha

# ============ Segredos de sessão (gerados por deploy/gerar-segredos.sh) ============
JWT_SECRET=<SEGREDO>
JWT_REFRESH_SECRET=<SEGREDO>
CSRF_SECRET=<SEGREDO>

# ============ Origem do front e CORS ============
# Endereço público do front (sem barra final). Em dev: https://gestao-dev.fadasdobem.com.br
FADAS_ORIGIN=https://gestao.fadasdobem.com.br
CORS_ORIGINS=https://gestao.fadasdobem.com.br
# SOCKET_CORS_ORIGIN=https://gestao.fadasdobem.com.br

# ============ Módulo Gestão Fadas ============
GESTAO_FADAS_ENABLED=true
GESTAO_FADAS_GATE_ENABLED=true
# Login da própria API A (contas criadas em users). NÃO use proxy-b em produção.
GATE_SESSAO=nativa
# "production" faz o /api/ops/health anunciar ambiente "prd".
FADAS_ENVIRONMENT=production
# Dados novos vão para o PostgreSQL (padrão).
GF_NOVOS_DADOS=postgres
# Gravações no banco NOVO (PostgreSQL). NÃO é escrita no legado (essa é GF_LEGADO_*).
GESTAO_FADAS_ESCRITA_ENABLED=true
# Página com senha de teste: SEMPRE false em produção.
DADOS_TESTE_ENABLED=false
# Identidade do build no /api/ops/health (opcional; preenchidos na atualização).
# GATE_RELEASE_ID=<id do release>
# GATE_COMMIT_SHA=<sha de 40 caracteres>

# ============ Banco LEGADO ASP32 (MySQL/MariaDB "fadasdobem") ============
# Etapa 0: usuário SÓ com SELECT. Etapas 1 a 3: usuário dedicado com SELECT, INSERT e UPDATE (nunca DDL, nunca DELETE).
LEGADO_DB_HOST=<host do banco da KingHost>
LEGADO_DB_PORT=3306
LEGADO_DB_NAME=fadasdobem
LEGADO_DB_USER=<usuário dedicado da API>
LEGADO_DB_PASSWORD=<SEGREDO>
# O MariaDB da KingHost não usa TLS (ligar quebra o ASP): manter false.
LEGADO_DB_SSL=false
# Etapa 0: true (sessão somente leitura). Etapas 1 a 3: false (senão toda escrita é recusada).
LEGADO_DB_READ_ONLY=true
LEGADO_DB_STATEMENT_TIMEOUT_S=10

# ============ Fatias do painel (uma flag por fatia; só "true" liga; ligadas na ETAPA 0) ============
GF_FINANCEIRO_REGRAS=true
GF_FATIA_HORARIOS=true
GF_FATIA_PRESENCA=true
GF_FATIA_AGENDA=true
# ETAPA 0 (só ver o legado): false. Ligada, o front troca a tela de Consultas do legado pela do banco novo. Liga na etapa 2.
GF_FATIA_CONSULTA=false
GF_FATIA_CADASTROS=true
GF_FATIA_PRECOS=true
# ETAPA 0 (só ver o legado): false. Ligada, o front troca Recebimentos/Pagamentos do legado pelo livro do banco novo. Liga na etapa 3.
GF_FATIA_PAGAMENTOS=false
GF_FATIA_RESTRICOES=true
GF_FATIA_PAINEL=true
GF_FATIA_CLIENTES=true
GF_FATIA_RECADOS=true
GF_FATIA_CONTAS=true
GF_FATIA_CONFIG=true
GF_FATIA_DIVERGENCIAS=true
GF_FATIA_PENDENCIAS=true
GF_FATIA_FICHA=true
GF_FATIA_ESTADO_FINANCEIRO=true

# ============ Escrita no LEGADO (doc Maturacao/45 e 46). TODAS false na ETAPA 0 ============
# Interruptor geral. Só vale se a flag da entidade também estiver true E o banco estiver na trava.
GF_LEGADO_ESCRITA_ENABLED=false
# Etapa 1 liga estas duas:
GF_LEGADO_CLIENTES=false
GF_LEGADO_TAROLOGOS=false
# Etapa 2 liga estas três (NOTAS só depois de as contas terem legacyId):
GF_LEGADO_CONSULTAS=false
GF_LEGADO_STATUS_TAROLOGO=false
GF_LEGADO_NOTAS=false
# Etapa 3 liga esta (SÓ com saldo inicial validado e status 0 lido como Informado):
GF_LEGADO_PAGAMENTOS=false
# Trava de banco: nomes de banco onde a escrita é permitida. VAZIA na etapa 0.
# O código ainda recusa "fadasdobem" e "fadasdobem02" mesmo se listados (ver Maturacao/54, passo de liberação).
GF_LEGADO_ESCRITA_BANCOS=
# Modo de escrita: "primeiro" (padrão, legado antes do Postgres). Não mude sem ordem.
GF_LEGADO_MODO=primeiro
# Conferência periódica do espelho (opcional; desligada).
GF_LEGADO_VERIFICACAO=false
