# Cabeçalhos de segurança do FRONT (location / ). A API já envia os dela (helmet), então não entram em /api/.
# Cole dentro do `location / { ... }` do server do domínio. Sem Content-Security-Policy de propósito: o front não foi desenhado
# para uma CSP restrita e uma política errada quebra a tela.
add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "SAMEORIGIN" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
